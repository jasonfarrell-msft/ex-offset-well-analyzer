{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/calibration/attempt.schema.json",
  "title": "Fabric Data Agent calibration attempt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "case_id",
    "attempt",
    "workspace_id",
    "data_agent_id",
    "model_id",
    "versions",
    "model_input",
    "started_at_utc",
    "ended_at_utc",
    "latency_seconds",
    "status",
    "response_text",
    "error",
    "security_failure",
    "cost_usd"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$"
    },
    "case_id": {
      "type": "string",
      "pattern": "^summary-v1\\.0\\.0-[ACR][0-9]{2}$"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "workspace_id": {
      "const": "4e1977a8-d7ff-487e-b42d-c4b3bc118f3d"
    },
    "data_agent_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": {
        "const": "00000000-0000-0000-0000-000000000000"
      }
    },
    "model_id": {
      "const": "ee7583b6-5be7-4802-83a8-530ce7dd8351"
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runner",
        "workspace",
        "data_agent",
        "model",
        "evaluation"
      ],
      "properties": {
        "runner": {
          "const": "1.1.0"
        },
        "workspace": {
          "const": "security-posture-v1.0.0"
        },
        "data_agent": {
          "const": "da_drillrun_summary-definition-v1.0.1"
        },
        "model": {
          "const": "sm_drillrun_summary-v1.0.0"
        },
        "evaluation": {
          "const": "summary-v1.0.0"
        }
      }
    },
    "model_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question"
      ],
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "started_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "latency_seconds": {
      "type": "number",
      "minimum": 0
    },
    "status": {
      "enum": [
        "SUCCESS",
        "ERROR",
        "HARD_GATE_FAILURE"
      ]
    },
    "response_text": {
      "type": [
        "string",
        "null"
      ]
    },
    "error": {
      "type": [
        "object",
        "null"
      ]
    },
    "security_failure": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pattern_category"
          ],
          "properties": {
            "pattern_category": {
              "enum": [
                "bearer_token",
                "jwt",
                "private_key",
                "credential_assignment"
              ]
            }
          }
        }
      ]
    },
    "cost_usd": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    }
  }
}
