model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	discourageImplicitMeasures
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["SqlEndpointHost","SqlEndpointDatabase","Wells","Dataset Metadata","Data Quality","Categories"]

annotation PBI_ProTooling = ["DevMode","TMDL-Extension"]

ref table Wells
ref table 'Dataset Metadata'
ref table 'Data Quality'
ref table Categories

ref cultureInfo en-US

