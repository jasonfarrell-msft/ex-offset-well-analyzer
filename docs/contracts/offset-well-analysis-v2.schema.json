{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:drillrun:contracts:offset-well-analysis-v2",
  "title": "Proposed Offset Well Analysis v2 local test profile",
  "description": "Not a deployed API or authentication/completeness proof. Examples are non-authoritative shape fixtures; golden answers remain grader-only in tests. Cross-field and numerical rules are normative in the companion markdown. GUD-001\u2013005 are approved for M1/M2 local contract/oracle work and use only within separately gated M2 windows; they do not authorize production implementation or deployment.",
  "oneOf": [
    {
      "$ref": "#/$defs/targetsRequest"
    },
    {
      "$ref": "#/$defs/candidatesRequest"
    },
    {
      "$ref": "#/$defs/compareRequest"
    },
    {
      "$ref": "#/$defs/chatRequest"
    },
    {
      "$ref": "#/$defs/analyticalResponse"
    },
    {
      "$ref": "#/$defs/chatResponse"
    },
    {
      "$ref": "#/$defs/failureResponse"
    }
  ],
  "$defs": {
    "contractVersion": {
      "const": "offset-well-analysis-v2"
    },
    "releaseId": {
      "const": "v1.2.0:6370024a3cdec3e3a4fdb3e9525bfe54d88d92375af7a74836461520e5617ab0"
    },
    "manifestSha256": {
      "const": "6370024a3cdec3e3a4fdb3e9525bfe54d88d92375af7a74836461520e5617ab0"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
    },
    "opaqueId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{16,80}$(?![\\s\\S])"
    },
    "targetId": {
      "type": "string",
      "pattern": "^SYN-TARGET-(?:000[1-9]|001[0-2])$(?![\\s\\S])"
    },
    "wellId": {
      "type": "string",
      "pattern": "^SYN-WELL-(?:00[0-9][0-9]|0100)$(?![\\s\\S])",
      "not": {
        "const": "SYN-WELL-0000"
      }
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "decimal": {
      "type": "string",
      "maxLength": 40,
      "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,12})?$(?![\\s\\S])"
    },
    "nullableDecimal": {
      "anyOf": [
        {
          "$ref": "#/$defs/decimal"
        },
        {
          "type": "null"
        }
      ]
    },
    "coordinate": {
      "type": "string",
      "pattern": "^(?:0|-?(?:[1-9][0-9]{0,5}|1000000))$(?![\\s\\S])",
      "maxLength": 8
    },
    "criteria": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "radiusFt",
        "formationMatch",
        "holeSizeMatch",
        "mdOverlap"
      ],
      "properties": {
        "radiusFt": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]{0,6})(?:\\.[0-9]{1,6})?$(?![\\s\\S])",
          "maxLength": 14
        },
        "formationMatch": {
          "type": "boolean"
        },
        "holeSizeMatch": {
          "type": "boolean"
        },
        "mdOverlap": {
          "type": "boolean"
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetId",
        "criteria",
        "selectedWellIds",
        "contextRevision"
      ],
      "properties": {
        "targetId": {
          "$ref": "#/$defs/targetId"
        },
        "criteria": {
          "$ref": "#/$defs/criteria"
        },
        "selectedWellIds": {
          "type": "array",
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/wellId"
          }
        },
        "contextRevision": {
          "$ref": "#/$defs/count"
        }
      },
      "examples": [
        {
          "targetId": "SYN-TARGET-0001",
          "criteria": {
            "radiusFt": "10000",
            "formationMatch": true,
            "holeSizeMatch": true,
            "mdOverlap": false
          },
          "selectedWellIds": [
            "SYN-WELL-0019"
          ],
          "contextRevision": 1
        }
      ]
    },
    "unselectedContext": {
      "allOf": [
        {
          "$ref": "#/$defs/context"
        },
        {
          "properties": {
            "selectedWellIds": {
              "maxItems": 0
            }
          }
        }
